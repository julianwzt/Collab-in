# Template environment variable backend Collab-in. Salin menjadi .env (di-.gitignore),
# isi nilai asli, lalu export sebelum menjalankan:  set -a; . ./.env; set +a; ./mvnw spring-boot:run
DB_URL=jdbc:mysql://localhost:3306/collabin?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-admin-service-account.json
APP_AUTH_TOKEN_SECRET=ganti-dengan-string-acak-minimal-32-karakter
APP_BASE_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
SERVER_PORT=8082
